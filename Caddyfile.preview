{
	auto_https off
}

:80 {
	log {
		output stdout
		format console
	}

	encode gzip

	# FastAPI dev server (uvicorn --reload) at /api/*
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Pocketbase at /pb/*
	handle_path /pb/* {
		reverse_proxy pocketbase:8090
	}

	# Vite dev server with HMR (WebSocket auto-supported by reverse_proxy)
	handle {
		reverse_proxy frontend:5173
	}
}
