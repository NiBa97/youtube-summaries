# Single public entrypoint via Caddy
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Set to a real hostname (e.g. yts.example.com) to enable Caddy auto-HTTPS.
# Leave empty for local: Caddy listens on :80 only.
APP_DOMAIN=

# Backend (FastAPI) — internal only, mounted at /api/*
BACKEND_CORS_ORIGINS=*
PB_URL=http://pocketbase:8090

# Gemini API key for slide generation (server-side only — never reaches the browser)
GEMINI_API_KEY=

# Frontend build args — relative paths because everything is one origin
VITE_BACKEND_URL=/api
VITE_PB_URL=/pb

# Pocketbase superuser bootstrap (used on first start with empty pb_data)
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=changeme-please-1234
